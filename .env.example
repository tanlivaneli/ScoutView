FOOTBALL_DATA_API_KEY=your_football_data_org_key_here

# Optional, local development only — enables a richer player profile
# (detailed per-competition stats, photo, trophy cabinet) via API-Sports.
# Do NOT set this in any deployed/public environment: API-Sports' free
# tier gets suspended when it sees public production traffic, which is
# what happened the last time this app was deployed with it configured.
# API_SPORTS_KEY=your_api_sports_key_here
